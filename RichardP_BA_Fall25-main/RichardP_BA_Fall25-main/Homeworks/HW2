DECLARE @serve_time DATETIME2 = '2025-09-28 18:00:00'; 

SELECT dish_or_phase,
       task_name,
       equipment,
       duration_min,
       StartTime = DATEADD(MINUTE, -1 * (offset_end_min + duration_min), @serve_time),
       EndTime   = DATEADD(MINUTE, -1 *  offset_end_min,                  @serve_time)
FROM dbo.tasks
ORDER BY StartTime;
