IF OBJECT_ID('dbo.table_requirements') IS NOT NULL DROP TABLE dbo.table_requirements;
CREATE TABLE dbo.table_requirements (
  item_name       VARCHAR(40) PRIMARY KEY,
  quantity_needed INT NOT NULL,
  quantity_owned  INT NOT NULL
);


INSERT INTO dbo.table_requirements (item_name, quantity_needed, quantity_owned) VALUES
('Placemat',     4, 4),
('Dinner Plate', 4, 4),
('Fork',         4, 4),
('Knife',        4, 4),
('Spoon',        4, 4),
('Water Glass',  4, 4),
('Napkin',       4, 4);


SELECT item_name,
       quantity_needed,
       quantity_owned,
       CASE WHEN quantity_owned >= quantity_needed THEN 'OK' ELSE 'NEED TO BUY' END AS status,
       CASE WHEN quantity_owned >= quantity_needed THEN 0 ELSE quantity_needed - quantity_owned END AS qty_to_buy
FROM dbo.table_requirements
ORDER BY item_name;


IF OBJECT_ID('dbo.tasks') IS NOT NULL DROP TABLE dbo.tasks;
CREATE TABLE dbo.tasks (
  task_id        INT IDENTITY(1,1) PRIMARY KEY,
  dish_or_phase  VARCHAR(60) NOT NULL,  
  task_name      VARCHAR(120) NOT NULL,
  equipment      VARCHAR(20) NOT NULL,  
  duration_min   INT NOT NULL,
  offset_end_min INT NOT NULL           
);

